# Keep this file as .env locally and NEVER commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVER_ONLY_SERVICE_ROLE_KEY_HERE

# Optional AI triage. The AI receives extracted strings and scanner indicators only,
# never the full uploaded binary. AI output is advisory and cannot mark a file clean.
AI_ENABLED=false
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
